{
  "name": "foreman",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "FOREMAN: golf shots knocking down houses, as a shot-budget puzzle game for the phone browser.",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "smoke": "node scripts/foreman/smoke.mjs && node scripts/golf-smoke.mjs && node scripts/smoke.mjs",
    "tune": "vitest run --config scripts/vitest.tune.config.ts --disableConsoleIntercept scripts/tune",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "probe": "vitest run --config scripts/foreman/vitest.config.ts --disableConsoleIntercept scripts/foreman/probe",
    "par": "vitest run --config scripts/golf/vitest.config.ts --disableConsoleIntercept",
    "novice": "vitest run --config scripts/golf/vitest.config.ts --disableConsoleIntercept scripts/golf/novice"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/three": "0.170.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/saira-stencil-one": "^5.3.0",
    "planck": "1.4.2",
    "three": "0.170.0"
  }
}
